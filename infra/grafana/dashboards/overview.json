{
  "uid": "mos-transport-overview",
  "title": "MosTransport — обзор стека",
  "tags": ["mos-transport"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Доступность сервисов",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=~\"backend|etl|ml\"}", "legendFormat": "{{job}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "недоступен", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "работает", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Запросы в секунду по сервисам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [{
        "expr": "sum by (job) (rate(http_requests_total[5m]))",
        "legendFormat": "{{job}}", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 времени ответа",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket[5m])))",
        "legendFormat": "{{job}}", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ошибки 5xx",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "targets": [{
        "expr": "sum by (job) (rate(http_requests_total{status=~\"5..\"}[5m]))",
        "legendFormat": "{{job}}", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Последние расчёты прогноза",
      "datasource": { "type": "postgres", "uid": "service-db" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "targets": [{
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT created_at AS \"Время\", model AS \"Модель\", origin AS \"Начало\", rows_predicted AS \"Часов\", round(total_prediction) AS \"Сумма прогноза\", round(ml_latency_ms::numeric, 1) AS \"ML, мс\" FROM forecast_runs ORDER BY created_at DESC LIMIT 20",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Запросы приложения из Logs DB",
      "datasource": { "type": "postgres", "uid": "logs-db" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [{
        "format": "time_series",
        "rawQuery": true,
        "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), service AS metric, count(*) AS value FROM logs WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1",
        "refId": "A"
      }]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Последние ошибки",
      "datasource": { "type": "postgres", "uid": "logs-db" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [{
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT ts AS \"Время\", service AS \"Сервис\", level AS \"Уровень\", status AS \"Код\", path AS \"Путь\", message AS \"Сообщение\", request_id AS \"Request ID\" FROM logs WHERE level IN ('ERROR','WARNING') ORDER BY ts DESC LIMIT 50",
        "refId": "A"
      }]
    }
  ]
}
