# Non-secret defaults for the isolated Backend service.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=1000
BACKEND_WORKERS=1
BACKEND_LOG_LEVEL=INFO
BACKEND_ETL_SERVICE_URL=http://etl:1010
BACKEND_ML_SERVICE_URL=http://ml:1020
BACKEND_KEYCLOAK_URL=http://keycloak:8080
# Confirm the realm name and issuer with the auth owner before enabling JWT verification.
BACKEND_KEYCLOAK_REALM=transport
# Leave empty when Frontend reverse-proxies the API on the same origin.
BACKEND_CORS_ALLOWED_ORIGINS=
BACKEND_K_MIN=0.5
BACKEND_K_MAX=1.5
BACKEND_K_DEFAULT=1.0
