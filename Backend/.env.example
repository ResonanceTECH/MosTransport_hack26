# Moscow Transport Hack - Environment Variables
# Copy this file to .env and fill in real values

# External API Keys
YANDEX_WEATHER_API_KEY=your_yandex_weather_api_key_here
YANDEX_MAPS_API_KEY=your_yandex_maps_api_key_here
MOSRU_API_KEY=your_mosru_api_key_here

# Database
DATABASE_URL=postgresql://admin:admin@db:5432/transport
LOGS_DATABASE_URL=postgresql://admin:admin@logs-db:5432/logs

# Backend
BACKEND_ETL_SERVICE_URL=http://etl:8000
BACKEND_KEYCLOAK_URL=http://keycloak:8080
BACKEND_KEYCLOAK_REALM=transport
BACKEND_LOG_LEVEL=INFO
BACKEND_WORKERS=2

# ETL
ETL_DATABASE_URL=postgresql://etl:etl@db:5432/transport
ETL_DATASET_PATH=/app/data/dataset.zip
ETL_LOG_LEVEL=INFO

# ML
ML_DATABASE_URL=postgresql://ml:ml@db:5432/transport
ML_LOG_LEVEL=INFO

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
